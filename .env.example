# ==============================================================================
# Grocery Choice Customer App - Environment Configuration Template
# Copy this file to .env or .env.local for local development overrides.
# NOTE: Real secrets, private keys, and passwords must NEVER be placed here.
# ==============================================================================

# Backend Spring Boot API Base URL (defaults to production Railway API if omitted)
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_URL=

# Customer Web Storefront URL (Payment Bridge Host for hosted Razorpay checkout)
EXPO_PUBLIC_CUSTOMER_WEB_URL=

# Razorpay Public Key ID (Client-side public key only; secrets must stay on server)
EXPO_PUBLIC_RAZORPAY_KEY_ID=
